 from plextraktsync.config import TRAKT_RETRY_AFTER_MARGIN
 from plextraktsync.factory import logging
+from plextraktsync.util.Timer import Timer
 
 logger = logging.getLogger(__name__)
 
+# https://docs.trakt.tv/docs/rate-limiting
+# Authed GET: 500 calls / 5 min (~0.6s/call), POST/PUT/DELETE: 1 call/sec.
+# Bulk syncs (per-episode tmdb/tvdb/imdb lookups) burst into 429s without
+# pacing, so throttle GETs proactively and honor Retry-After on 429.
+_GET_TIMER = Timer(delay=0.7)
+
+
+def _retry_after_seconds(e: RateLimitException, attempt: int) -> float:
+    for attr in ("retry_after", "retry_after_seconds"):
+        try:
+            value = getattr(e, attr, None)
+            if value is None:
+                continue
+            seconds = float(value)
+            if seconds > 0:
+                return seconds
+        except (TypeError, ValueError):
+            continue
+    response = getattr(e, "response", None)
+    headers = getattr(response, "headers", None) or getattr(e, "headers", None) or {}
+    for key in ("Retry-After", "retry-after"):
+        if key in headers:
+            try:
+                return max(1.0, float(headers[key]))
+            except (TypeError, ValueError):
+                break
+    # exponential fallback when server gives no Retry-After, cap 60s
+    return float(min(2**attempt, 60))
+
+
+def _ratelimit_info(e: RateLimitException) -> str:
+    response = getattr(e, "response", None)
+    headers = getattr(response, "headers", None) or getattr(e, "headers", None) or {}
+    for key in ("X-Ratelimit", "X-RateLimit", "x-ratelimit"):
+        if key in headers:
+            return f" {key}: {headers[key]}"
+    return ""
+
 
