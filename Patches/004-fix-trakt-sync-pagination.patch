 from __future__ import annotations
 
+from typing import Final
+
 from trakt.core import get
 from trakt.utils import airs_date
 
+# Since 2026 Trakt paginates sync/watched and sync/collection and omits the season/episode
+# breakdown unless extended=progress is requested (max 100 per page). Without this the shows
+# arrive with seasons=None and parsing crashes. https://github.com/trakt/trakt-api/discussions/775
+_PAGE_SIZE: Final[int] = 100
+
 
-@get
 def allwatched():
-    # returns an AllShowProgress object containing all watched shows
-    data = yield "sync/watched/shows"
-    yield AllShowsProgress(data)
+    return AllShowsProgress(_all_pages(_watched_shows_page))
 
 
-@get
 def allcollected():
-    # returns an AllShowProgress object containing all collected shows
-    data = yield "sync/collection/shows"
-    yield AllShowsProgress(data)
+    return AllShowsProgress(_all_pages(_collected_shows_page))
+
+
+def _all_pages(fetch_page):
+    shows = []
+    page = 1
+    while data := fetch_page(page):
+        shows.extend(data)
+        if len(data) < _PAGE_SIZE:
+            break
+        page += 1
+    return shows
+
+
+@get
+def _watched_shows_page(page):
+    data = yield f"sync/watched/shows?extended=progress&page={page}&limit={_PAGE_SIZE}"
+    yield data
+
+
+@get
+def _collected_shows_page(page):
+    data = yield f"sync/collection/shows?extended=metadata&page={page}&limit={_PAGE_SIZE}"
+    yield data
 
 
