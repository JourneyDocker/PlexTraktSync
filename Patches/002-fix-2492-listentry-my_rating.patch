 from trakt.tv import TVEpisode, TVSeason, TVShow
 from trakt.users import PublicList, User
 
+# Workaround: Trakt API now returns 'my_rating' in list item data,
+# but ListEntry is a frozen dataclass that doesn't accept it.
+# Filter to known fields to prevent TypeError on unexpected API additions.
+from trakt.users import ListEntry
+
+_orig_process_items = PublicList._process_items
+
+
+def _patched_process_items(items):
+    for item in items:
+        if "type" not in item:
+            continue
+        data = item.pop(item["type"])
+        if "show" in item:
+            data["show"] = item.pop("show")
+        known_fields = {"id", "rank", "listed_at", "type", "data", "notes"}
+        filtered = {k: v for k, v in item.items() if k in known_fields}
+        yield ListEntry(**filtered, data=data)
+
+
+PublicList._process_items = staticmethod(_patched_process_items)
+
 from plextraktsync.factory import factory, logging
